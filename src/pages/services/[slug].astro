---
import Base from '../../layouts/Base.astro';
import { services } from '../../data/services';
import { BOOKING_URL } from '../../config';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const service = services.find((s) => s.slug === slug)!;
---
<Base title={`${service.title} — Taylored AI`} description={service.short}>
  <header class="page-hero">
    <div class="wrap">
      <div class="breadcrumb"><a href="../../">Home</a> / <a href="../">Services</a> / {service.title}</div>
      <span class="eyebrow">{service.tag}</span>
      <h1>{service.title}</h1>
      <p class="lede">{service.intro}</p>
    </div>
  </header>

  <section class="section wrap" style="padding-top:12px">
    <div class="detail-grid">
      <div class="prose">
        {service.sections.map((sec) => (
          <>
            <h2>{sec.heading}</h2>
            <p>{sec.body}</p>
            {sec.bullets && (
              <ul>
                {sec.bullets.map((b) => <li><strong>{b.split(' — ')[0]}</strong>{b.includes(' — ') ? ' — ' + b.split(' — ').slice(1).join(' — ') : ''}</li>)}
              </ul>
            )}
          </>
        ))}

        <h2>What you receive</h2>
        <ul>
          {service.deliverables.map((d) => <li>{d}</li>)}
        </ul>

        <h2>Common questions</h2>
        <div class="faq">
          {service.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>

        <div class="assess" style="margin-top:40px;padding:34px">
          <div>
            <h2 style="font-size:1.4rem">Ready to talk about {service.title.toLowerCase()}?</h2>
            <p>Book a free 30-minute consult — no pitch, just an honest read on your situation.</p>
          </div>
          <a href={BOOKING_URL} class="btn btn-light">Book a call</a>
        </div>
      </div>

      <aside class="detail-side">
        <div class="side-card">
          <h3>All services</h3>
          <ul>
            {services.map((s) => (
              <li><a href={`../${s.slug}/`} style={s.slug === service.slug ? 'font-weight:700;color:var(--ink)' : ''}>{s.title}</a></li>
            ))}
          </ul>
        </div>
        <div class="side-card">
          <h3>Free assessment</h3>
          <p style="font-size:0.93rem;color:var(--ink-soft)">Find out which service fits your situation in 5 minutes — instant score, no strings.</p>
          <p style="margin-top:14px"><a class="btn btn-primary" href="../assessment/" style="padding:10px 18px;font-size:0.88rem">Start now</a></p>
        </div>
      </aside>
    </div>
  </section>
</Base>